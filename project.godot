; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Xeque & Mate"
config/version="0.8"
config/tags=PackedStringArray("game")
run/main_scene="uid://dlp8rih41k8c0"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

Global="*uid://qbinf4bs82e2"
CombatManager="*uid://bw3i554iyfbxo"

[debug]

gdscript/warnings/unused_signal=0
gdscript/warnings/unsafe_call_argument=1
gdscript/warnings/missing_await=1

[display]

window/size/viewport_width=640
window/size/viewport_height=340
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/handheld/orientation=4

[editor]

run/main_run_args="web"

[file_customization]

folder_colors={
"res://Assets/Credits/": "gray",
"res://autoload/": "yellow"
}

[global_group]

TileMap=""

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/main_run_args="web"

[layer_names]

2d_physics/layer_1="Player"
2d_physics/layer_2="Ground"
2d_physics/layer_3="Inimigos"

[physics]

common/physics_ticks_per_second=30
3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
